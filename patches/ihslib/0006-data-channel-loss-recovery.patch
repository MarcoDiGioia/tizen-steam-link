Let the data channels recover from lost packets.

Video and audio packets are unreliable and are not resent, so a frame that loses a packet
never completes. Three things kept the channel from getting past one:

- The data worker discarded stale packets (older than 200 ms) only once per frame polled.
  With an incomplete frame at the head it waited and polled again on every new packet, and
  never discarded, until the window overflowed.
- On overflow, discarding with a 0 ms limit only drops frames older than the newest packet's
  frame, which can be nothing; every later packet then overflowed again. Video stayed frozen
  for the rest of the session with "Video channel items overflow!" repeated.
- A window filled to the last slot, with its head not at slot 0, had tail.pos + 1 == head.pos,
  which IHS_SessionPacketsWindowSize reads as empty.

Now the worker discards on every wake-up, an overflow resets the window and starts over with
the incoming packet (and still reports the loss so the host sends a keyframe), and the window
keeps one slot free.

diff -ruN b/src/session/channels/ch_data.c c/src/session/channels/ch_data.c
--- b/src/session/channels/ch_data.c	2026-10-16 12:51:58.946904114 -0500
+++ c/src/session/channels/ch_data.c	2026-10-16 12:51:58.959225811 -0500
@@ -82,7 +82,10 @@
     if (!IHS_SessionPacketsWindowAdd(dataCh->window, packet)) {
         IHS_SessionLog(channel->session, IHS_LogLevelWarn, "Data", "%s channel items overflow! Available: %u",
                        DataChannelName(channel->type), IHS_SessionPacketsWindowAvailable(dataCh->window));
-        IHS_SessionPacketsWindowDiscard(dataCh->window, 0);
+        // Discarding by timestamp could free nothing here (it keeps every frame that starts as
+        // late as the newest packet), and every later packet overflowed again. Start over.
+        IHS_SessionPacketsWindowReset(dataCh->window);
+        IHS_SessionPacketsWindowAdd(dataCh->window, packet);
         IHS_SessionChannelDataLost(channel);
     }
     IHS_CondSignal(dataCh->windowCond);
@@ -127,16 +130,20 @@
     IHS_SessionLog(channel->base.session, IHS_LogLevelInfo, "Data", "%s channel started", channelName);
     while (!channel->interrupted) {
         IHS_MutexLock(channel->windowLock);
-        uint16_t discarded = IHS_SessionPacketsWindowDiscard(channel->window, DISCARD_DIFF);
-        if (discarded > 0) {
-            IHS_SessionLog(channel->base.session, IHS_LogLevelDebug, channelName, "Discarded %u packets", discarded);
-        }
         bool hasFrame;
-        while (!(hasFrame = IHS_SessionPacketsWindowPoll(channel->window, &frame))) {
-            IHS_CondWait(channel->windowCond, channel->windowLock);
-            if (channel->interrupted) {
+        for (;;) {
+            // Discard on every wake-up, not once per frame: a frame that lost a packet never
+            // completes, and polling alone would wait behind it until the window overflowed.
+            uint16_t discarded = IHS_SessionPacketsWindowDiscard(channel->window, DISCARD_DIFF);
+            if (discarded > 0) {
+                IHS_SessionLog(channel->base.session, IHS_LogLevelDebug, channelName, "Discarded %u packets",
+                               discarded);
+            }
+            hasFrame = IHS_SessionPacketsWindowPoll(channel->window, &frame);
+            if (hasFrame || channel->interrupted) {
                 break;
             }
+            IHS_CondWait(channel->windowCond, channel->windowLock);
         }
         IHS_MutexUnlock(channel->windowLock);
         if (hasFrame) {
diff -ruN b/src/session/window.c c/src/session/window.c
--- b/src/session/window.c	2026-10-16 12:51:58.958765503 -0500
+++ c/src/session/window.c	2026-10-16 12:51:58.959146121 -0500
@@ -87,8 +87,10 @@
     if (tailOffset > window->capacity) {
         return true;
     }
-    /* Large offset means overflow, abort processing and hangup */
-    if (tailOffset > (int) IHS_SessionPacketsWindowAvailable(window)) {
+    /* Large offset means overflow, abort processing and hangup. One slot always stays free: in a
+     * full window whose head isn't at slot 0, tail.pos + 1 == head.pos, which Size reads as empty,
+     * and Poll and Discard would never touch it again. */
+    if (tailOffset >= (int) IHS_SessionPacketsWindowAvailable(window)) {
         return false;
     }
     const int writePos = (window->tail.pos + tailOffset + window->capacity) % window->capacity;
@@ -208,6 +210,17 @@
     return true;
 }
 
+void IHS_SessionPacketsWindowReset(IHS_SessionPacketsWindow *window) {
+    for (int i = 0; i < window->capacity; i++) {
+        if (FrameItemIsUsed(&window->data[i])) {
+            FrameItemRecycle(&window->data[i]);
+        }
+    }
+    window->head.pos = 0;
+    window->tail.pos = -1;
+    window->tail.id = 0;
+}
+
 void IHS_SessionPacketsWindowReleaseFrame(IHS_SessionFrame *frame) {
     IHS_SessionFrameClear(frame, false);
 }
